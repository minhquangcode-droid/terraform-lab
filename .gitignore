# Terraform working directories
**/.terraform/*

# Terraform state
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Variable files thường chứa secrets
*.tfvars
*.tfvars.json

# Nhưng có thể commit file mẫu
!*.tfvars.example
!*.tfvars.json.example

# Saved plan files
*.tfplan
tfplan

# Override files thường chỉ dùng local
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform CLI configuration
.terraformrc
terraform.rc

# Sensitive/generated files
*.pem
*.key

# OS / IDE
.DS_Store
.idea/
.vscode/
